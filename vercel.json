{
  "version": 2,
  "name": "fish-flocking-simulation",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "sardine.glb",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sardine\\.glb).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sardine.glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
